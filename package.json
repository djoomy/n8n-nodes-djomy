{
	"name": "n8n-nodes-djomy",
	"version": "0.1.1",
	"description": "n8n node to automate payments processing with Djomy",
	"license": "MIT",
	"homepage": "https://djomy.africa",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Oury Diallo",
		"email": "amadoury313@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/djoomy/n8n-nodes-djomy.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "node --test tests/*.test.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/DjomyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Djomy/Djomy.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
